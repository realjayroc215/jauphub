{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Node",
    "allowJs": false,
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "jsx": "preserve",
    "incremental": true,
    "resolveJsonModule": true,
    "types": [
      "@cloudflare/workers-types",
      "node"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": [
        "core/*"
      ],
      "@agents/*": [
        "core/agents/*"
      ],
      "@workspace/*": [
        "core/workspace/*"
      ],
      "@drive/*": [
        "core/drive/*"
      ],
      "@utils/*": [
        "core/utils/*"
      ],
      "@design/*": [
        "src/design-system/*"
      ],
      "@hooks/*": [
        "src/hooks/*"
      ],
      "@app/*": [
        "src/app/*"
      ]
    },
    "ignoreDeprecations": "6.0",
    "noEmit": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "src/**/*",
    "core/**/*",
    "app/**/*",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist"
  ]
}
